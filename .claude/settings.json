{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(scripts/docs/validate.sh)",
      "Bash(scripts/docs/check-links.sh)",
      "Bash(scripts/docs/check-version-consistency.sh)",
      "Bash(scripts/docs/check-foundation-coverage.sh)",
      "Bash(scripts/docs/check-rule-frontmatter.sh)",
      "Bash(scripts/docs/secret-scan.sh)",
      "Bash(scripts/graphify/build.sh)",
      "Bash(scripts/graphify/query-smoke.sh)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(sha256sum:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git tag:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh release:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*service-account*.json)",
      "Read(./**/secrets/**)",
      "Read(./**/*.sql)",
      "Read(./**/*.dump)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git tag -f:*)",
      "Bash(git tag -d:*)",
      "Bash(git push --delete:*)",
      "Bash(git reset --hard:*)",
      "Bash(git rebase:*)",
      "Bash(git filter-branch:*)",
      "Bash(rm -rf:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/hooks/guard-dangerous-commands.sh"
          }
        ]
      }
    ]
  }
}
