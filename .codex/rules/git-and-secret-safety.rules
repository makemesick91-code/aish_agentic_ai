# Codex execpolicy — git, secret, and destructive-command safety (Aish Agentic AI)
# Governance: .claude/rules/13, 15; AFR-023, AFR-067, AFR-070.
# Format: prefix_rule(program, args, decision) where decision in {"forbidden","prompt","safe"}.
# Inline tests use "# TEST: <block|prompt|allow> <command>" and are checked by scripts/codex/check-codex.sh.
# NOTE: Codex CLI is not installed in the authoring environment; runtime verification via
#   codex execpolicy check --pretty --rules .codex/rules/git-and-secret-safety.rules -- <command>
# is DOCUMENTED, not executed (OD-07). Rules that parse but fail to block a dangerous command are a FAILURE.

# ---------------------------------------------------------------------------
# FORBIDDEN — never allowed (history/tag destruction, secret reads, prod/destructive)
# ---------------------------------------------------------------------------
prefix_rule(program="git", args=["push", "--force"],            decision="forbidden")
prefix_rule(program="git", args=["push", "-f"],                 decision="forbidden")
prefix_rule(program="git", args=["push", "--force-with-lease"], decision="forbidden")
prefix_rule(program="git", args=["push", "--delete"],           decision="forbidden")
prefix_rule(program="git", args=["push", "origin", "--delete"], decision="forbidden")
prefix_rule(program="git", args=["tag", "-d"],                  decision="forbidden")
prefix_rule(program="git", args=["tag", "-f"],                  decision="forbidden")
prefix_rule(program="git", args=["tag", "--delete"],            decision="forbidden")
prefix_rule(program="git", args=["reset", "--hard"],            decision="forbidden")
prefix_rule(program="git", args=["filter-branch"],              decision="forbidden")
prefix_rule(program="git", args=["filter-repo"],                decision="forbidden")
prefix_rule(program="git", args=["clean", "-x"],                decision="forbidden")
prefix_rule(program="gh",  args=["secret"],                     decision="forbidden")
prefix_rule(program="cat", args=[".env"],                       decision="forbidden")
prefix_rule(program="cat", args=["*.pem"],                      decision="forbidden")
prefix_rule(program="cat", args=["*.key"],                      decision="forbidden")
# Destructive production / infra / package publishing
prefix_rule(program="php",        args=["artisan", "migrate:fresh"], decision="forbidden")
prefix_rule(program="dropdb",     args=[],                           decision="forbidden")
prefix_rule(program="composer",   args=["publish"],                  decision="forbidden")
prefix_rule(program="npm",        args=["publish"],                  decision="forbidden")

# TEST: block git push --force origin main
# TEST: block git push -f origin main
# TEST: block git push origin --delete refs/tags/x
# TEST: block git tag -d aish-agentic-ai-step-3-application-architecture-adr-v1.0.0-go
# TEST: block git tag -f aish-agentic-ai-docs-foundation-v1.0.0-go
# TEST: block git reset --hard origin/main
# TEST: block cat .env
# TEST: block gh secret set FOO

# ---------------------------------------------------------------------------
# PROMPT — require explicit approval (mutating / external / config-changing)
# ---------------------------------------------------------------------------
prefix_rule(program="git", args=["push"],           decision="prompt")
prefix_rule(program="git", args=["tag", "-a"],      decision="prompt")
prefix_rule(program="gh",  args=["pr", "create"],   decision="prompt")
prefix_rule(program="gh",  args=["pr", "merge"],    decision="prompt")
prefix_rule(program="composer", args=["install"],   decision="prompt")
prefix_rule(program="composer", args=["require"],   decision="prompt")
prefix_rule(program="npm",  args=["install"],       decision="prompt")

# TEST: prompt git push -u origin docs/step-3-application-architecture-adr-foundation
# TEST: prompt git tag -a aish-agentic-ai-step-3-application-architecture-adr-v1.0.0-go -m msg
# TEST: prompt gh pr create --fill
# TEST: prompt gh pr merge 5 --merge

# ---------------------------------------------------------------------------
# SAFE — read-only / validation (no mutation, no secret exposure)
# ---------------------------------------------------------------------------
prefix_rule(program="git", args=["status"],       decision="safe")
prefix_rule(program="git", args=["diff"],         decision="safe")
prefix_rule(program="git", args=["log"],          decision="safe")
prefix_rule(program="git", args=["show"],         decision="safe")
prefix_rule(program="git", args=["rev-parse"],    decision="safe")
prefix_rule(program="git", args=["ls-remote"],    decision="safe")
prefix_rule(program="gh",  args=["pr", "view"],   decision="safe")
prefix_rule(program="gh",  args=["pr", "checks"], decision="safe")
prefix_rule(program="bash", args=["scripts/docs/validate.sh"], decision="safe")
prefix_rule(program="bash", args=["scripts/docs/secret-scan.sh"], decision="safe")

# TEST: allow git status
# TEST: allow git diff --stat
# TEST: allow git ls-remote --tags origin
# TEST: allow gh pr checks 5
# TEST: allow scripts/docs/validate.sh

# ---------------------------------------------------------------------------
# CICD-CTRL-1 (rule 28) — CI/release mutations require approval; local CI gates are safe.
# ---------------------------------------------------------------------------
prefix_rule(program="gh",   args=["release"],  decision="prompt")
prefix_rule(program="gh",   args=["api"],      decision="prompt")
prefix_rule(program="bash", args=["scripts/ci/fast-local.sh"],  decision="safe")
prefix_rule(program="bash", args=["scripts/ci/full-local.sh"],  decision="safe")
prefix_rule(program="bash", args=["scripts/ci/audit-ci-runs.sh"], decision="safe")

# TEST: prompt gh release create aish-agentic-ai-cicd-ctrl-1-safe-ci-runtime-control-v1.0.0-go
# TEST: prompt gh api repos/makemesick91-code/aish_agentic_ai/rulesets
# TEST: allow scripts/ci/fast-local.sh
