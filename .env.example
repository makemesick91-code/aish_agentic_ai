# Aish Agentic AI — environment contract (Step 5 runtime bootstrap).
# SAFE PLACEHOLDERS ONLY. Never put real secrets, tokens, or credentials here or
# commit a real environment file (rule 04, rule 24). Copy and fill locally:
#   cp .env.example .env && php artisan key:generate
#
# The DB/Redis host+port+credentials below match the bundled docker-compose.yml
# (`make up`) so `make bootstrap` works out of the box. These are LOCAL, non-secret
# development defaults only. For native services, change them to your local ports
# (typically 5432 / 6379) and credentials.

APP_NAME="Aish Agentic AI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Makassar
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

# Never enable debug in staging/pilot/production (rule 04, rule 23).
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- Database: PostgreSQL (canonical; ADR 0038, rule 25) — matches docker-compose ---
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=55432
DB_DATABASE=aish_agentic_ai
DB_USERNAME=aish
DB_PASSWORD=aish_local_dev

# --- Cache / Session / Queue: Redis (ADR 0038, rule 08) — matches docker-compose ---
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis

# predis = pure-PHP client (no extension required; default). phpredis is an optional
# production performance optimization (requires the php-redis extension).
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=63790

FILESYSTEM_DISK=local

# Mail: log driver for local development (no external delivery).
MAIL_MAILER=log

# Trusted proxies: comma-separated hosts/CIDRs. Do NOT use "*" in production
# without a controlled ingress (rule 04). Empty = trust none.
TRUSTED_PROXIES=


# --- Step 6 — SaaS Core Foundation (safe placeholders only; never real secrets) ---
# Session security. In production over HTTPS these MUST be tightened (secure cookies).
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# Transactional mail identity (development/test uses a safe local mail driver).
MAIL_FROM_ADDRESS="no-reply@aishagentic.test"
MAIL_FROM_NAME="${APP_NAME}"

# SaaS core behaviour. Public/self-service registration is DISABLED in Step 6 (rule 30);
# users arrive via secure provisioning + invitation only.
AUTH_REGISTRATION_ENABLED=false
TENANT_INVITATION_EXPIRY_DAYS=7
